{
  "name": "nderja",
  "main": "worker.js",
  "compatibility_date": "2026-07-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nderja-map",
      "database_id": "PLACEHOLDER-RUN-D1-CREATE"
    }
  ]
}
