{
  "name": "nderja",
  "main": "worker.js",
  "compatibility_date": "2026-07-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "nderja.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nderja-map",
      "database_id": "3e83c255-566f-4afa-9283-7b16d26a2097"
    }
  ]
}
